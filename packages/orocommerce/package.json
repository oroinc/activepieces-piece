{
  "name": "@oroinc/piece-orocommerce",
  "version": "1.0.0",
  "description": "Activepieces piece for the OroCommerce back-office JSON:API: create and update customers, customer users, back-office users, orders and invoices, and trigger flows from OroCommerce webhooks.",
  "keywords": [
    "activepieces",
    "oro",
    "orocommerce",
    "orocrm",
    "b2b",
    "ecommerce",
    "json-api"
  ],
  "author": "Oro, Inc. (https://oroinc.com)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/oroinc/activepieces-piece/tree/main/packages/orocommerce#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oroinc/activepieces-piece.git",
    "directory": "packages/orocommerce"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "dependencies": {
    "@activepieces/pieces-common": "workspace:*",
    "@activepieces/pieces-framework": "workspace:*",
    "@activepieces/core-piece-types": "workspace:*",
    "@activepieces/core-utils": "workspace:*",
    "undici": "7.30.0"
  },
  "scripts": {
    "build": "node ../../scripts/bundle.mjs",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts' 'tools/**/*.mjs'",
    "bundle": "node ../../scripts/bundle.mjs",
    "test": "vitest run",
    "i18n:check": "node tools/check-i18n.mjs",
    "i18n:write": "node tools/check-i18n.mjs --write"
  }
}
