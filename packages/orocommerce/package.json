{
  "name": "@activepieces/piece-orocommerce",
  "version": "0.3.0",
  "description": "Activepieces piece for the OroCommerce back-office JSON:API: create and update customers, customer users, back-office users, orders and invoices, and trigger flows from OroCommerce webhooks.",
  "keywords": [
    "activepieces",
    "orocommerce",
    "orocrm",
    "b2b",
    "ecommerce",
    "json-api"
  ],
  "license": "MIT",
  "homepage": "https://github.com/oroinc/activepieces/tree/main/packages/pieces/community/orocommerce#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oroinc/activepieces.git",
    "directory": "packages/pieces/community/orocommerce"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "dependencies": {
    "@activepieces/pieces-common": "workspace:*",
    "@activepieces/pieces-framework": "workspace:*",
    "@activepieces/core-piece-types": "workspace:*",
    "@activepieces/core-utils": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json && cp package.json dist/",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts' 'tools/**/*.mjs'",
    "bundle": "node ../../../../dist/packages/cli/src/index.js pieces bundle",
    "test": "vitest run",
    "i18n:check": "node tools/check-i18n.mjs",
    "i18n:write": "node tools/check-i18n.mjs --write"
  },
  "devDependencies": {
    "vitest": "3.2.6",
    "tslib": "2.6.2"
  }
}
